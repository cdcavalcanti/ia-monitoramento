# Mantenha em sincronia com app/config.py, senão este arquivo vira documentação
# mentirosa.

# ---- Infinity Lab (GPU própria — agente "IA de Monitoramento") ----
# Prioridade sobre OpenAI. Prompt/conhecimento ficam no Lab.
INFINITY_LAB_BASE_URL=https://infinity-lab.ai-infinity.io
INFINITY_LAB_AGENT_ID=
INFINITY_LAB_API_KEY=

# ---- OpenAI (fallback opcional) ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o

# ---- Gestão Infinity ----
GESTAO_API_BASE_URL=https://gestao-infinity.ai-infinity.io
RELATORIO_API_TOKEN=

# ---- Painel de Serviços / Hub de Status ----
PAINEL_API_BASE_URL=https://painel-infinity.vercel.app
# Basic Auth (login do painel) OU Bearer token de máquina
PAINEL_API_USER=
PAINEL_API_PASSWORD=
PAINEL_BASIC_AUTH=
PAINEL_API_TOKEN=
PAINEL_ENABLED=false

# ---- Chatwoot / saúde das IAs ----
CHATWOOT_BASE_URL=https://chat.iainfinity.com.br
# Contas dos CLIENTES (Nome:id). Sem a Infinity/1.
CHATWOOT_ACCOUNTS=tecnodiesel:34,AIASSOC:31:222+199,Hollytec:30:198,Sua marca seu legado:29:214,Clinic +:26:165+186,Vai xora tintas:21:143,akila conections:20:118,espaco infinity:19:81,hile:18:77,astro:17:64+144,transfast:15,borelli:9:136,light:8:230,RHT:6:70,Infinity:1:112+113
# Legado single-account (só se CHATWOOT_ACCOUNTS vazio)
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_HEALTH_ENABLED=false
CHATWOOT_INBOX_ID=
CHATWOOT_SILENCE_MINUTES=5
CHATWOOT_ONLY_TODAY=true
CHATWOOT_POLL_SECONDS=60
# Limites POR CONTA
CHATWOOT_MAX_PAGES=5
CHATWOOT_MAX_CONVERSATIONS=80
CHATWOOT_PAUSE_LABELS=pausar_ia,pausar-ia,pause_ia,ia_pausada
CHATWOOT_SKIP_LABELS=lead_agendado,transferido,atendimento_humano,humano,handoff,agendado,consulta_agendada

# ---- Reprocessamento (Francisco / chat-reprocessor) ----
REPROCESS_API_BASE_URL=https://chat-reprocessor.vercel.app
REPROCESS_API_TOKEN=
REPROCESS_ENABLED=false
REPROCESS_PATH=/api/reprocess/automatic

# ---- auth da UI/API (login único via env + cookie HMAC) ----
# Vazio = SEM auth (uso local). Obrigatória ANTES de expor com túnel.
# Gerar NA VPS (nunca colar em chat):
#   AUTH_PASSWORD: openssl rand -base64 18 | tr -d '=+/'
#   AUTH_SECRET:   openssl rand -hex 32
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_SECRET=
AUTH_SESSION_HOURS=12

# ---- WAHA (entrega + saúde de sessões) ----
WAHA_URL=https://waha.iainfinity.com.br
WAHA_TOKEN=
WAHA_SESSION=ALPHA_TESTE
NOTIFY_WHATSAPP_TO=
# true = monitora GET /api/sessions e alerta queda/recuperação no Zap
WAHA_HEALTH_ENABLED=false

# ---- alertas 24h ----
ALERT_POLLER_ENABLED=true
ALERT_POLL_SECONDS=60
# WAHA: só alerta no Zap se ficar FORA de WORKING por N segundos (anti flip-flop STARTING)
WAHA_ALERT_DEBOUNCE_SECONDS=300
# Resumo periódico (minutos). 0 = desliga. Default 120 = a cada 2h se ainda houver ruins.
WAHA_ALERT_DIGEST_MINUTES=120
# true = não manda Zap a cada STARTING→FAILED→SCAN_QR; só borda WORKING ↔ fora
WAHA_ALERT_ONLY_WORKING_EDGE=true

# ---- relatórios (NÃO é o poller 24h) ----
# Manhã + noite
REPORT_TIMES=08:00,20:00
REPORT_HOUR=8
REPORT_MINUTE=0
REPORT_TIMEZONE=America/Sao_Paulo
SCHEDULER_ENABLED=true
MONITOR_ENABLED=true

# ---- storage ----
DATA_DIR=data
SQLITE_PATH=data/monitoramento.db
